# Ejemplo de /etc/zscore-license.env (copiar al servidor, completar y dejar con permisos 600, solo root).
# NO subir este archivo con datos reales al repositorio.

# --- Mercado Pago (Tus integraciones > tu aplicación) ---
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Correo saliente (SMTP). Ejemplos:
#   Gmail:  SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   (usuario = tu Gmail, contraseña = "contraseña de aplicación")
#   Hosting/dominio propio: los datos los da tu proveedor (casi siempre puerto 465 o 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=licencias@tudominio.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=Z-Score Lite <licencias@tudominio.com>

# --- Opcionales ---
# TRIAL_DAYS=14        # días de la prueba gratis desde la app (0 = apagada)
